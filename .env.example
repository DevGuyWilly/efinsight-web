# Leave empty in dev: the app calls same-origin /api/... and Vite proxies to the backend (no CORS needed).
# Set to an absolute URL (e.g. https://api.example.com) only if the backend allows CORS for this origin.
VITE_API_BASE_URL=

# Where `vite dev` proxies /api, /callback and /auth/connect-bank.
VITE_DEV_PROXY_TARGET=http://localhost:8080
